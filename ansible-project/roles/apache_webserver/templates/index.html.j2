<!DOCTYPE html>
<html>
<head>
    <title>System Info - {{ ansible_hostname }}</title>
    <style>
        body { font-family: Arial; background: #f0f2f5; padding: 20px; }
        .container { max-width: 600px; margin: 0 auto; background: white; padding: 30px; border-radius: 10px; }
        h1 { color: #333; border-bottom: 2px solid #4CAF50; }
        .info { margin: 15px 0; padding: 10px; background: #f8f9fa; border-left: 4px solid #4CAF50; }
        .label { font-weight: bold; display: inline-block; width: 140px; }
    </style>
</head>
<body>
    <div class="container">
        <h1>🖥️ System Information - {{ ansible_hostname }}</h1>
        <div class="info">
            <span class="label">Hostname:</span> {{ ansible_hostname }}
        </div>
        <div class="info">
            <span class="label">CPU Cores:</span> {{ ansible_processor_cores }}
        </div>
        <div class="info">
            <span class="label">CPU Threads:</span> {{ ansible_processor_vcpus }}
        </div>
        <div class="info">
            <span class="label">RAM:</span> {{ ansible_memtotal_mb }} MB
        </div>
        <div class="info">
            <span class="label">OS:</span> {{ ansible_distribution }} {{ ansible_distribution_version }}
        </div>
        <div class="info">
            <span class="label">Uptime:</span> {{ (ansible_uptime_seconds / 3600) | int }} hours
        </div>
        <div style="margin-top: 20px; color: #999; text-align: center;">
            Generated: {{ ansible_date_time.iso8601 }}
        </div>
    </div>
</body>
</html>